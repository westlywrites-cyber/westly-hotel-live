auto-install-peers=false
strict-peer-dependencies=false

# Auth for Replit's package firewall (required when NPM_CONFIG_REGISTRY points to it)
# REPLIT_SESSION is set automatically by the Replit environment; harmless when unset (e.g. Cloudflare Pages CI)
//package-firewall.replit.local/npm/:_authToken=${REPLIT_SESSION}
