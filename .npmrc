auto-install-peers=false
strict-peer-dependencies=false

# Note: Replit's package firewall requires auth to download tarballs.
# Configure this locally via your home ~/.npmrc or by setting the env var:
#   NPM_CONFIG_//package-firewall.replit.local/npm/:_authToken=$REPLIT_SESSION
# Do NOT put ${REPLIT_SESSION} here — CI environments (Cloudflare Pages, etc.)
# will warn about the unresolvable env variable.
