rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════════
// Westly Demo Hotel — Firestore Security Rules
// Server-side RBAC enforcement: client-side checks are UX only.
// Every privileged write is validated here.
//
// AUTH ARCHITECTURE NOTE — shared-device PIN login
// Every role check below (isSuperAdmin, isManager, isReceptionist, etc.)
// depends on request.auth.uid, which requires a real Firebase Auth session.
//
// The shared-device PIN login (PinLoginPage → netlify/functions/verify-pin.ts
// → lib/auth.ts's verifyPin) now produces exactly that: the server function
// verifies the PIN with the Admin SDK (bypassing rules, as trusted server
// code is allowed to) and mints a Firebase custom token, which the client
// exchanges via signInWithCustomToken(). That token carries a `pinSession:
// true` custom claim, which AuthContext reads via getIdTokenResult() to tell
// PIN sessions apart from full email/password logins (for the 15-minute
// inactivity auto-logout) — but as far as these rules are concerned, a
// PIN-logged-in user is fully authenticated with a normal request.auth.uid,
// same as anyone else. No special-casing is needed here for PIN sessions.
// ══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: auth basics ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ── Helper: load the Firestore user profile for the caller ────────────────
    // Returns null-safe: if the document doesn't exist the function returns null
    // and callers that depend on role/status will deny the request.
    function userDoc() {
      let ref = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(ref) ? get(ref).data : null;
    }

    function getUserRole() {
      let d = userDoc();
      return d != null ? d.role : null;
    }

    function isActive() {
      let d = userDoc();
      return d != null && d.status == 'active';
    }

    // ── Role shortcuts ────────────────────────────────────────────────────────
    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'super_admin' && isActive();
    }

    function isManager() {
      return isSignedIn() && getUserRole() == 'manager' && isActive();
    }

    function isReceptionist() {
      return isSignedIn() && getUserRole() == 'receptionist' && isActive();
    }

    function isAccountant() {
      return isSignedIn() && getUserRole() == 'accountant' && isActive();
    }

    function isStaff() {
      return isSignedIn() && getUserRole() == 'staff' && isActive();
    }

    function isWaiter() {
      return isSignedIn() && getUserRole() == 'waiter' && isActive();
    }

    function isHousekeeping() {
      return isSignedIn() && getUserRole() == 'housekeeping' && isActive();
    }

    function isBarAttendant() {
      return isSignedIn() && getUserRole() == 'bar_attendant' && isActive();
    }

    function isLaundryValet() {
      return isSignedIn() && getUserRole() == 'laundry_valet' && isActive();
    }

    function isOperationsManager() {
      return isSignedIn() && getUserRole() == 'operations_manager' && isActive();
    }

    function isMaintenanceTechnician() {
      return isSignedIn() && getUserRole() == 'maintenance_technician' && isActive();
    }

    function isSecurityGuard() {
      return isSignedIn() && getUserRole() == 'security_guard' && isActive();
    }

    function isDriver() {
      return isSignedIn() && getUserRole() == 'driver' && isActive();
    }

    function isRestaurantAttendant() {
      return isSignedIn() && getUserRole() == 'restaurant_attendant' && isActive();
    }

    function isKitchenStaff() {
      return isSignedIn() && getUserRole() == 'kitchen_staff' && isActive();
    }

    function isGymStaff() {
      return isSignedIn() && getUserRole() == 'gym_staff' && isActive();
    }

    // Any of the newer single-purpose front-line roles added for shift
    // scheduling — none of them have bespoke collection access beyond
    // tasks/shifts/notifications/attendance, so they're grouped here.
    function isFrontlineOpsRole() {
      return isMaintenanceTechnician() || isSecurityGuard() || isDriver()
        || isRestaurantAttendant() || isKitchenStaff();
    }

    // Any active admin user (any role)
    function isAnyAdmin() {
      return isSignedIn() && isActive() && getUserRole() in [
        'super_admin', 'manager', 'receptionist', 'accountant',
        'staff', 'waiter', 'housekeeping', 'bar_attendant', 'laundry_valet',
        'operations_manager', 'maintenance_technician', 'security_guard',
        'driver', 'restaurant_attendant', 'kitchen_staff', 'gym_staff'
      ];
    }

    // Upper management: super_admin or manager
    function isManagement() {
      return isSuperAdmin() || isManager();
    }

    // Front-desk staff: super_admin, manager, or receptionist
    function isFrontDesk() {
      return isSuperAdmin() || isManager() || isReceptionist();
    }

    // Finance team
    function isFinance() {
      return isSuperAdmin() || isManager() || isAccountant();
    }

    // Anyone who oversees housekeeping operations end-to-end (assigns rooms,
    // assigns/reassigns tasks, sees every housekeeper's queue).
    function isHousekeepingSupervisor() {
      return isManagement() || isOperationsManager();
    }

    // Anyone who oversees gym operations end-to-end (Super Admin, Manager,
    // Operations Manager) — same "management + ops manager" shape as
    // housekeeping, since these are the roles the spec calls out as needing
    // to view memberships/attendance/reports and manage Gym Staff.
    function isGymSupervisor() {
      return isManagement() || isOperationsManager();
    }

    // ── Housekeeping room-ownership guard ──────────────────────────────────
    // room_assignments/{roomId} is a denormalized, one-doc-per-room mirror of
    // "who currently owns this room" (see ROOM ASSIGNMENTS section below) —
    // the same mirror-collection pattern already used for booking_dates.
    // Keying it by roomId means a room can only ever have ONE current
    // assignee, which is what makes "housekeepers can't see other
    // housekeepers' rooms" enforceable here rather than merely in the UI.
    function currentRoomAssignee(roomId) {
      let ref = /databases/$(database)/documents/room_assignments/$(roomId);
      return exists(ref) ? get(ref).data.housekeeperId : null;
    }

    // True if the caller is the housekeeper currently responsible for roomId
    // — either because a task is directly assigned to them, or because they
    // hold the long-term assignment for that room right now.
    function ownsHousekeepingTask(taskData) {
      return taskData.assignedTo == request.auth.uid
          || currentRoomAssignee(taskData.roomId) == request.auth.uid;
    }

    // ── Public self-service ordering guard ────────────────────────────────────
    // The "Place Order" QR menu (GuestOrderPage.tsx) writes as an unauthenticated
    // guest. It may create an order, but only as an unclaimed, self-declared
    // 'pending' request — never pre-approved, never assigned to a real staff
    // member, and never carrying staff-only fields. A waiter/manager later
    // claims it (assigning waiterId) and progresses status normally, same as
    // any order taken in person.
    function isValidPublicOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'waiterId', 'waiterName', 'customerName', 'roomNumber', 'tableNumber',
            'items', 'total', 'paymentMethod', 'notes', 'hasManualItems',
            'status', 'approvalStatus', 'approvedBy', 'approvedByName',
            'approvedAt', 'rejectedReason', 'createdAt', 'isDeleted', 'source'
          ])
          && d.source == 'qr_menu'
          && d.waiterId == 'unassigned'
          && d.status == 'pending'
          && d.approvalStatus == 'pending'
          && d.approvedBy == null && d.approvedByName == null && d.approvedAt == null
          && d.isDeleted == false
          && d.items is list && d.items.size() > 0 && d.items.size() <= 40
          && d.total is number && d.total > 0
          && d.paymentMethod in ['room_charge', 'pay_on_delivery']
          // Room-billed orders require server-side guest verification (see
          // netlify/functions/verify-guest-order.ts, which uses the Admin
          // SDK and bypasses these rules entirely). An unauthenticated
          // client may still self-declare a *table* order — that's a
          // walk-in restaurant diner, not tied to any guest/room record —
          // but can never set roomNumber directly.
          && d.roomNumber == null
          && d.tableNumber is string && d.tableNumber.size() > 0;
    }

    // ── Soft-delete guard: prevent reading/mutating records marked deleted ────
    // Collections that support soft delete must use this guard on writes.
    function notSoftDeleting() {
      return !('isDeleted' in request.resource.data)
          || request.resource.data.isDeleted == false;
    }

    // ── Public self-service booking guards ─────────────────────────────────────
    // The public Book-a-Room page (BookingPage.tsx) writes as an unauthenticated
    // visitor. It may create a booking, but only as an unconfirmed, self-declared
    // 'pending' request — never already confirmed/checked-in, and never carrying
    // staff-only fields like updatedBy/checkedInBy.
    function isValidPublicBooking() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.source == 'website'
          && d.guestName is string && d.guestName.size() > 0
          && d.guestEmail is string && d.guestEmail.size() > 0
          && d.roomId is string && d.roomId.size() > 0
          && d.checkIn is timestamp
          && d.checkOut is timestamp
          && d.checkOut > d.checkIn
          && !('updatedBy' in d) && !('checkedInBy' in d) && !('checkedOutBy' in d);
    }

    // Matching guard for the denormalized booking_dates doc created alongside
    // it — this is the ONLY thing about a booking that's publicly readable,
    // so it must never carry guest name/email/phone.
    function isValidPublicBookingDates() {
      let d = request.resource.data;
      return d.keys().hasOnly(['roomId', 'checkIn', 'checkOut', 'status'])
          && d.status == 'pending'
          && d.roomId is string && d.roomId.size() > 0
          && d.checkIn is timestamp
          && d.checkOut is timestamp
          && d.checkOut > d.checkIn;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // USERS
    // ══════════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      // Single-document reads: a user reads their own profile; super_admin reads any.
      allow get: if isSignedIn() && (
        request.auth.uid == userId || isSuperAdmin()
      );

      // Collection-wide reads (staff directories, Attendance's headcount, etc).
      // A rule of the form "request.auth.uid == userId || isSuperAdmin()" can't
      // be proven safe for an unfiltered list/collection query for anyone but
      // super_admin, so Firestore silently denies the WHOLE query for everyone
      // else — this previously made "Total Staff" on the Attendance page show
      // stale/cached/inconsistent numbers per browser instead of the real count.
      // Scoped to the same roles that can already view /attendance.
      allow list: if isSignedIn() && (isManagement() || isReceptionist() || isSuperAdmin() || isOperationsManager());

      // Self-signup (AdminSetupPage) is allowed, but a self-created account
      // must land in 'pending' status — it has NO access until an existing
      // Super Admin reviews it and flips status to 'active' from /admin/users.
      // Only an existing Super Admin may create an account that is already
      // active/privileged (the real invitation-flow path).
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.status == 'pending')
        || isSuperAdmin()
      );

      // Update: super_admin manages any user;
      // a user may update their own non-role fields (lastLogin, PIN hash, etc.).
      allow update: if isSignedIn() && (
        isSuperAdmin()
        || (request.auth.uid == userId && isActive()
            && !('role' in request.resource.data.diff(resource.data).affectedKeys())
            && !('status' in request.resource.data.diff(resource.data).affectedKeys()))
      );

      // Hard-delete is never allowed — soft delete only.
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ROLES (configuration documents)
    // NOTE: not currently used — RolesPage.tsx reads role definitions from the
    // static src/lib/rbac.ts config, not Firestore. Rule kept in case that
    // moves to Firestore later; harmless either way.
    // ══════════════════════════════════════════════════════════════════════════
    match /roles/{roleId} {
      allow read:  if isAnyAdmin();
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SYSTEM METADATA — one-time seed sentinel doc(s).
    // CRITICAL: this must NEVER be writable from the browser. The app's
    // seedData.ts currently tries to write here (and to users/rooms/inventory/
    // cms_content) directly from an unauthenticated client on first page load —
    // that pattern is incompatible with real security rules and must be
    // replaced with a one-time server-side seed script (Firebase Admin SDK)
    // before these rules go live, or seeding will simply fail (safely, but
    // silently) and the app will start with an empty database.
    // ══════════════════════════════════════════════════════════════════════════
    match /system_meta/{docId} {
      allow read:  if true;   // harmless: only reveals whether seeding has run
      allow write: if false;  // never from the client — Admin SDK / console only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ROOMS
    // ══════════════════════════════════════════════════════════════════════════
    match /rooms/{roomId} {
      // Public read — used by the booking page and public website.
      allow read: if true;

      // Only super_admin may create rooms.
      allow create: if isSuperAdmin();

      // Room status / data updates: super_admin, manager, receptionist, housekeeping.
      allow update: if isSuperAdmin() || isManager() || isReceptionist() || isHousekeeping();

      // Hard-delete never allowed.
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // VENUES — public read (public Venue page), Super Admin manages
    // ══════════════════════════════════════════════════════════════════════════
    match /venues/{venueId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false; // soft delete only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BOOKINGS
    // ══════════════════════════════════════════════════════════════════════════
    match /bookings/{bookingId} {
      allow read:   if isAnyAdmin();
      // Staff (front desk) create confirmed/walk-in bookings; the public
      // website may also create its own 'pending' request, validated above.
      allow create: if isFrontDesk() || isValidPublicBooking();
      allow update: if isFrontDesk();
      allow delete: if false; // soft delete only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BOOKING DATES — denormalized, PII-free mirror of bookings (roomId +
    // date range + status only). Exists so the public booking page can check
    // room availability without needing read access to guest names/emails,
    // which /bookings intentionally restricts to staff. Every place that
    // creates or changes a booking's status must keep this in sync.
    // ══════════════════════════════════════════════════════════════════════════
    match /booking_dates/{bookingId} {
      allow read:   if true;
      allow create: if isFrontDesk() || isValidPublicBookingDates();
      allow update: if isAnyAdmin();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // GUESTS
    // ══════════════════════════════════════════════════════════════════════════
    match /guests/{guestId} {
      allow read:   if isAnyAdmin();
      allow create: if isFrontDesk();
      allow update: if isFrontDesk();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CHECK-INS
    // ══════════════════════════════════════════════════════════════════════════
    match /checkins/{checkinId} {
      allow read:   if isAnyAdmin();
      allow create: if isSuperAdmin() || isReceptionist();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CHECK-OUTS
    // ══════════════════════════════════════════════════════════════════════════
    match /checkouts/{checkoutId} {
      allow read:   if isAnyAdmin();
      allow create: if isSuperAdmin() || isReceptionist();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ATTENDANCE
    // ══════════════════════════════════════════════════════════════════════════
    match /attendance/{attendanceId} {
      allow read:   if isManagement() || isReceptionist() || isOperationsManager();
      allow create: if isSuperAdmin() || isReceptionist();
      allow update: if isSuperAdmin() || isReceptionist();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SALES
    // ══════════════════════════════════════════════════════════════════════════
    match /sales/{saleId} {
      // Staff may only read their own sales; management reads all.
      allow read: if isManagement() || isAccountant()
                  || (isStaff() && resource.data.staffId == request.auth.uid);
      allow create: if isSuperAdmin() || isStaff();
      // Accountant may update a sale to approve/reject it as revenue.
      allow update: if isSuperAdmin() || isAccountant();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // EXPENSES
    // ══════════════════════════════════════════════════════════════════════════
    match /expenses/{expenseId} {
      allow read:   if isFinance();
      allow create: if isFinance();
      allow update: if isFinance();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // INVENTORY
    // ══════════════════════════════════════════════════════════════════════════
    match /inventory/{itemId} {
      allow read:   if isAnyAdmin();
      // Finance/management create and update stock levels.
      // Staff and waiter may update (decrement) stock during a sale; bar
      // attendants may restock/adjust drink-category items the same way.
      allow create: if isFinance();
      allow update: if isFinance() || isStaff() || isWaiter() || isBarAttendant();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYMENTS
    // ══════════════════════════════════════════════════════════════════════════
    match /payments/{paymentId} {
      allow read:   if isFinance() || isReceptionist();
      allow create: if isSuperAdmin() || isReceptionist();
      allow update: if isSuperAdmin() || isAccountant();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // NOTIFICATIONS (staged before Telegram forwarding)
    // ══════════════════════════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read:   if isAnyAdmin();
      allow create: if isAnyAdmin();
      allow update: if isAnyAdmin();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // AUDIT LOGS — append-only, never modified or deleted
    // ══════════════════════════════════════════════════════════════════════════
    match /audit_logs/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isAnyAdmin();   // any admin may append
      allow update: if false;          // immutable once written
      allow delete: if false;          // permanent record
    }

    // ══════════════════════════════════════════════════════════════════════════
    // DELETED RECORDS — soft-delete archive; only super_admin may restore/purge
    // ══════════════════════════════════════════════════════════════════════════
    match /deleted_records/{recordId} {
      allow read:   if isSuperAdmin();
      allow create: if isAnyAdmin();     // any admin can trigger a soft-delete
      allow update: if isSuperAdmin();   // restore operations
      allow delete: if isSuperAdmin();   // purge operations
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CMS CONTENT — public read, super_admin write
    // ══════════════════════════════════════════════════════════════════════════
    match /cms_content/{docId} {
      allow read:  if true;
      // The restaurant menu (RestaurantManagementPage.tsx), the facilities
      // list, the gallery (GalleryManagementPage.tsx), and the gym content
      // page are all editable by Manager as well as Super Admin, matching
      // each page's route access. Every other CMS document (homepage
      // content, hero banners, etc.) remains super_admin-only.
      allow write: if docId in ['restaurant_menu', 'bar_menu', 'gallery', 'facilities', 'gym'] ? isManagement() : isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // WEBSITE SETTINGS — public read, super_admin write
    // ══════════════════════════════════════════════════════════════════════════
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // NOTE: galleries, facilities, and page content are NOT separate top-level
    // collections in this app — they're stored as documents inside cms_content
    // (e.g. cms_content/gallery, cms_content/facilities), which is already
    // covered by the CMS CONTENT rule above. No separate match blocks needed.
    // ══════════════════════════════════════════════════════════════════════════

    // ══════════════════════════════════════════════════════════════════════════
    // CONTACT MESSAGES — DEPRECATED top-level collection. Public-website
    // contact-form messages now live in Supabase (see supabase/schema.sql and
    // src/lib/messages.ts), not here. This rule block is kept only so any
    // pre-migration documents already in this collection remain readable by
    // staff; the public Contact page no longer writes to it.
    // ══════════════════════════════════════════════════════════════════════════
    match /contact_messages/{msgId} {
      allow create: if true;               // legacy — no longer used by the app
      allow read:   if isManagement();
      allow update: if isManagement();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PUBLIC GUEST REVIEWS — anyone (no sign-in) may submit a review; it
    // starts 'pending' and is invisible on the public site until a Manager
    // or Super Admin approves it. Management can read every review
    // (pending + approved) to moderate; the public can only ever read
    // approved ones.
    //
    // NOTE on the read rule: for a `list` query, Firestore rejects the whole
    // request unless the rule can be proven true for every document the
    // query *could* return — it doesn't filter document-by-document. So a
    // public client must query with `where('status','==','approved')`
    // (see the public GuestReviews section) for the rule below to pass;
    // any attempt to list unfiltered/pending reviews as a guest is denied.
    // ══════════════════════════════════════════════════════════════════════════
    function isValidReviewSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'text', 'rating', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'text', 'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
        && d.status == 'pending'
        && (!('rating' in d) || d.rating == null || (d.rating is int && d.rating >= 1 && d.rating <= 5));
    }

    match /reviews/{reviewId} {
      allow read:   if isManagement() || resource.data.status == 'approved';
      allow create: if isValidReviewSubmission();
      allow update: if isManagement();
      allow delete: if isManagement();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ROOM SERVICE / RESTAURANT ORDERS
    // ══════════════════════════════════════════════════════════════════════════
    match /orders/{orderId} {
      allow read:   if isManagement() || isWaiter() || isAccountant() || isOperationsManager();
      // Staff take orders directly. Guests scanning the "Place Order" QR
      // code for a TABLE create their own via isValidPublicOrder(); guests
      // ordering to a ROOM go through the verify-guest-order function
      // instead (Admin SDK, bypasses these rules) after identity checks.
      allow create: if isSuperAdmin() || isWaiter() || isValidPublicOrder();
      // Waiter/manager update kitchen fulfillment status (including claiming
      // an unassigned guest order by setting waiterId); accountant updates
      // the separate approvalStatus field to approve/reject revenue.
      allow update: if isSuperAdmin() || isWaiter() || isManager() || isAccountant();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BAR SALES
    // ══════════════════════════════════════════════════════════════════════════
    match /bar_orders/{orderId} {
      allow read:   if isManagement() || isBarAttendant() || isAccountant() || isOperationsManager();
      allow create: if isSuperAdmin() || isBarAttendant();
      // Bar attendant/manager update fulfillment status; accountant updates
      // the separate approvalStatus field to approve/reject revenue.
      allow update: if isSuperAdmin() || isBarAttendant() || isManager() || isAccountant();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // LAUNDRY REQUESTS
    // ══════════════════════════════════════════════════════════════════════════
    match /laundry_requests/{requestId} {
      allow read:   if isManagement() || isLaundryValet() || isAccountant() || isOperationsManager();
      allow create: if isSuperAdmin() || isLaundryValet();
      // Laundry valet/manager advance status, edit charge, toggle payment;
      // accountant updates the separate approvalStatus field to approve/
      // reject revenue.
      allow update: if isSuperAdmin() || isLaundryValet() || isManager() || isAccountant();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // TASKS — Operations Manager assigns daily tasks across departments;
    // assigned staff read/update only tasks that include their own uid in
    // assignedToIds (provable for `where("assignedToIds","array-contains",uid)`
    // queries, same pattern as other array-membership rules in this file).
    // ══════════════════════════════════════════════════════════════════════════
    match /tasks/{taskId} {
      allow read:   if isManagement() || isOperationsManager()
                    || (isAnyAdmin() && request.auth.uid in resource.data.assignedToIds);
      allow create: if isSuperAdmin() || isOperationsManager();
      // Ops manager/management reassign, edit, or cancel; an assigned staff
      // member may only update their own task's progress (accept/start/complete).
      allow update: if isSuperAdmin() || isOperationsManager() || isManager()
                    || (isAnyAdmin() && request.auth.uid in resource.data.assignedToIds);
      allow delete: if false; // soft delete / cancel only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SHIFTS — Operations Manager builds and edits the staff roster. Each doc
    // is one dated shift occurrence (recurring shifts are pre-expanded into
    // individual docs sharing a seriesId — see src/lib/shifts.ts). Every
    // active staff member may read the schedule (needed for the shift board
    // / "who's on duty" visibility and for staff to see their own shifts),
    // but only management/Operations Manager may write it — least privilege,
    // matching the tasks collection's write model.
    // ══════════════════════════════════════════════════════════════════════════
    match /shifts/{shiftId} {
      allow read:   if isAnyAdmin();
      allow create: if isSuperAdmin() || isOperationsManager() || isManager();
      allow update: if isSuperAdmin() || isOperationsManager() || isManager();
      allow delete: if false; // soft cancel only (status: 'cancelled')
    }

    // ══════════════════════════════════════════════════════════════════════════
    // MAINTENANCE REQUESTS
    // ══════════════════════════════════════════════════════════════════════════
    match /maintenance/{recordId} {
      allow read:   if isManagement() || isHousekeeping() || isReceptionist() || isOperationsManager() || isMaintenanceTechnician();
      allow create: if isManagement() || isHousekeeping() || isReceptionist();
      allow update: if isManagement() || isHousekeeping() || isMaintenanceTechnician();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // HOUSEKEEPING TASKS — the cleaning/service queue. One doc per task
    // occurrence (checkout cleaning, occupied-stay daily service, or a
    // manual/ad-hoc task). Auto-generated entries are written by the
    // Netlify scheduled function via the Admin SDK (which bypasses these
    // rules by design); these rules govern client reads/writes only.
    //
    // Per Requirement 1 ("housekeepers should only see rooms assigned to
    // them"), a housekeeping-role caller may only read/update a task if
    // they're its assignee OR they currently hold the long-term assignment
    // for that task's room (ownsHousekeepingTask, above) — this is what lets
    // "cleaning history for my assigned rooms" work even for tasks another
    // housekeeper completed before the room was reassigned, without opening
    // up every other housekeeper's tasks.
    // ══════════════════════════════════════════════════════════════════════════
    match /housekeeping_tasks/{taskId} {
      allow read:   if isHousekeepingSupervisor()
                    || (isHousekeeping() && ownsHousekeepingTask(resource.data));
      // Ops Manager/management create & assign tasks (manual or bulk);
      // a housekeeper may also self-log a task (e.g. logging completed
      // ad-hoc work), matching the existing markClean() flow.
      allow create: if isSuperAdmin() || isHousekeepingSupervisor() || isHousekeeping();
      allow update: if isHousekeepingSupervisor()
                    || (isHousekeeping() && ownsHousekeepingTask(resource.data));
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ROOM ASSIGNMENTS — long-term room ownership (Requirement 2).
    //
    // room_assignment_groups/{groupId}: the record Operations Manager
    // actually creates/edits — one housekeeper, a set of rooms, a date
    // range. This is the audit-friendly source of truth.
    //
    // room_assignments/{roomId}: a denormalized, PII-free mirror keyed by
    // ROOM ID (not an auto id) — same "mirror collection" pattern as
    // booking_dates. Exactly one doc per actively-assigned room, so a room
    // can never be actively owned by two housekeepers at once, and a
    // housekeeper's dashboard/rules can answer "is this my room?" with a
    // single cheap lookup instead of scanning every group. Kept in sync by
    // src/lib/housekeeping.ts every time a group is created, edited,
    // reassigned, or ended.
    // ══════════════════════════════════════════════════════════════════════════
    match /room_assignment_groups/{groupId} {
      allow read:   if isHousekeepingSupervisor()
                    || (isHousekeeping() && request.auth.uid == resource.data.housekeeperId);
      allow create: if isHousekeepingSupervisor();
      allow update: if isHousekeepingSupervisor();
      allow delete: if false; // soft-end only (status: 'ended')
    }

    match /room_assignments/{roomId} {
      allow read:   if isHousekeepingSupervisor()
                    || (isHousekeeping() && request.auth.uid == resource.data.housekeeperId);
      // System-maintained mirror — only Operations Manager/management write
      // it (from src/lib/housekeeping.ts), never housekeeping directly.
      allow write:  if isHousekeepingSupervisor();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // LOST & FOUND — housekeepers log items found in guest rooms; Manager and
    // Super Admin review, search/filter, and update status. Housekeeping can
    // read (to see live status of what they logged) and create, but only
    // Management may change status — matches LostFoundPage.tsx's client-side
    // gating so the UI's permission model can't be bypassed via direct writes.
    // ══════════════════════════════════════════════════════════════════════════
    match /lost_found/{itemId} {
      allow read:   if isManagement() || isHousekeeping();
      allow create: if isManagement() || isHousekeeping();
      allow update: if isManagement();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // GYM MANAGEMENT — membership records + attendance/visit log for the
    // hotel gym. Gym Staff run day-to-day desk operations (registration,
    // renewals, check-in/out); Super Admin, Manager, and Operations Manager
    // oversee memberships, attendance, and reports without needing to be
    // Gym Staff themselves (isGymSupervisor(), same shape as housekeeping's
    // supervisor model above).
    // ══════════════════════════════════════════════════════════════════════════
    match /gym_members/{memberId} {
      allow read:   if isGymSupervisor() || isGymStaff();
      allow create: if isGymSupervisor() || isGymStaff();
      allow update: if isGymSupervisor() || isGymStaff();
      allow delete: if false; // soft delete only (isDeleted: true)
    }

    match /gym_attendance/{visitId} {
      allow read:   if isGymSupervisor() || isGymStaff();
      allow create: if isGymSupervisor() || isGymStaff();
      // Only the checkOutAt/checkedOutBy fields are ever updated after
      // creation (closing out an open visit) — enforced client-side by
      // src/lib/gym.ts; supervisors/gym staff may both do this so a shift
      // handover doesn't strand an open visit.
      allow update: if isGymSupervisor() || isGymStaff();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // NOTE: there is no separate /pages collection in this app either — dynamic
    // page content also lives inside cms_content. See note above ROOM SERVICE.
    // ══════════════════════════════════════════════════════════════════════════

    // ══════════════════════════════════════════════════════════════════════════
    // REALTIME DATABASE is governed by its own database.rules.json.
    // No permanent business records live there.
    // ══════════════════════════════════════════════════════════════════════════
  }
}
